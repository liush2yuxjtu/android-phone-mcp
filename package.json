{
  "name": "android-phone-mcp",
  "version": "0.1.0",
  "description": "Open-source MCP server that controls an Android emulator or device over ADB (stdio). Tool names align with AndroMeld's public MCP list; this project is not AndroMeld and is not affiliated with Catching Now.",
  "keywords": [
    "mcp",
    "android",
    "adb",
    "emulator",
    "model-context-protocol"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "android-phone-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liush2yuxjtu/android-phone-mcp.git"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
